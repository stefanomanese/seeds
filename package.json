{
  "name": "@two22/seeds",
  "version": "0.1.1",
  "description": "Git-native task tracker for agent workflows — structured issues, plan gates, and session context injection",
  "type": "module",
  "bin": {
    "seeds": "src/cli.ts",
    "sd": "src/cli.ts"
  },
  "main": "src/cli.ts",
