  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^6.0.3"
  }
}
